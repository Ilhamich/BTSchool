@model IList<Product>

@{
    ViewData["Title"] = "Home";
}
@{
    Random rnd = new Random();

    List<string> dogList = new List<string>
    {
       "bull-terrier.jpg",
       "Franch.jpg",
       "husky.jpg",
       "Pug.jpg",
       "Saluki.jpg"
    };
    <main>
        <div class="data-list">
            @foreach (var item in Model)
            {
                <div class="image-div" style="background-image: url(img/@dogList[rnd.Next(0,5)])">
                </div>
            }
        </div>
    </main>
}
