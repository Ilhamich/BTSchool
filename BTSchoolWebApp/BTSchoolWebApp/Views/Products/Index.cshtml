@model IList<Products>

@{
    ViewData["Title"] = "Home";
}
@{
    Random rnd = new Random();

    List<string> dogList = new List<string>
    {
       "bull-terrier.jpg",
       "Franch.jpg",
       "husky.jpg",
       "Pug.jpg",
       "Saluki.jpg"
    };

    <div id="dataList">
        foreach (var item in Model)
        {
        <div style="background-image: url(img/@dogList[rnd.Next(0,5)]); background-size:cover">
        </div>
        }
    </div>
}
